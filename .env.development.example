# Development Environment Example
# API Configuration where backend (ybb-platform) is hosted
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# S3 Storage Configuration
# Point to DigitalOcean Spaces bucket (Dev/Staging Shared)
# Format: https://<endpoint>/<bucket> (Path style) or https://<bucket>.<endpoint>
NEXT_PUBLIC_S3_URL=https://cdn.ybbhub.com

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Web app build/version identifier used for hard-refresh detection after deploys
APP_BUILD_ID=development

# Optional third-party chat widget config
NEXT_PUBLIC_CHAT_WIDGET_BOT_ID=

# Feature flags (default off; enable incrementally during rollout)
ENABLE_BRAND_SCOPED_CACHE=false
ENABLE_CSRF_GUARD=false
ENABLE_FILE_SERVICE_AUTH_REQUIRED=false
ENABLE_PAYMENT_OUTBOX=false
ENABLE_STRICT_REVALIDATE_AUTH=false
ENABLE_THIRD_PARTY_SCRIPT_GATING=false
